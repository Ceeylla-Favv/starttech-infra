ws_region           = "eu-west-1"
environment          = "production"
app_name             = "starttech"
frontend_bucket_name = "starttech-frontend-YOURINITIALS-2024"
ec2_instance_type    = "t3.micro"
ec2_key_name         = "starttech-key"
mongo_uri            = "mongodb+srv://starttech:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority"
asg_min_size         = 1
asg_max_size         = 4
asg_desired_capacity = 2
ecr_repository_url   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/starttech-backend"